# Slack
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here
# ^ only needed if running locally via Socket Mode (see README)

# Database
# Default: local SQLite (no setup needed). For anything beyond solo local
# testing, point this at a real Postgres instance instead, e.g.:
# DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage_bot
DATABASE_URL=sqlite:///./app.db

# App
APP_ENV=local
LOG_LEVEL=INFO

# Notification frequency
# P0: notify each firing unless within P0_DEBOUNCE_MINUTES of the last notify
P0_DEBOUNCE_MINUTES=2
# Non-P0: notify only after SPIKE_THRESHOLD firings in SPIKE_WINDOW_MINUTES;
# then wait NOTIFICATION_COOLDOWN_MINUTES before notifying again on the same spike
SPIKE_THRESHOLD=5
SPIKE_WINDOW_MINUTES=60
NOTIFICATION_COOLDOWN_MINUTES=15

# Feature flags (future phases)
ENABLE_LLM_COMPOSER=false
# Uses a local Ollama instance (free, no API key/account needed) --
# install from https://ollama.com, then `ollama pull llama3.2` and make
# sure `ollama serve` is running on localhost:11434 before enabling this.
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30
# Only needed if Ollama isn't on localhost (e.g. pointing at an
# in-cluster service in Kubernetes) -- leave as-is for local dev.
OLLAMA_BASE_URL=http://localhost:11434

# Jira (leave blank to run without Jira integration -- ticket creation
# will be skipped and logged, same dry-run pattern as Slack)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=OPS
JIRA_DEFAULT_ISSUE_TYPE=Task

CORRELATION_WINDOW_MINUTES=15

# API auth -- required header (X-API-Key) for mutating/sensitive endpoints.
# Generate with e.g. `openssl rand -hex 32`. Leave blank ONLY for local dev.
INTERNAL_API_KEY=

RATE_LIMIT_REQUESTS_PER_MINUTE=60
